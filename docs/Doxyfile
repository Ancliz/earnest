# Run from the repository root: doxygen docs/Doxyfile
PROJECT_NAME           = "Smart-home voice commands"
PROJECT_BRIEF          = "Speech recognition, interchangeable parsing, and checked command execution"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = src tests
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES    = YES
INHERIT_DOCS           = NO
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
