# Copy to .env and fill in. These values override environment variables; command-line options
# override both.

# Long-lived access token from your Home Assistant profile page.
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Parser for commands: hybrid (default: phrase rules, then the Ollama model), ollama, or regex,
# which needs no model server. --parser overrides it.
PARSER=hybrid

# Ollama server and an installed model that parses commands; --ollama-model overrides the model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Optional Spotify control server (~/repos/spotify) for casting, the queue and song requests.
# Leave empty to disable. Playback and volume still go through Home Assistant.
SPOTIFY_URL=

# Chatterbox speech server that voices replies, and the voice it should use.
CHATTERBOX_URL=http://localhost:4321
CHATTERBOX_VOICE=jarvis